# App configuration only. Copy to .env and supply your API keys.
# Pass --dart-define-from-file=.env to flutter run/build.

# Listings API
HEROKU_API=https://mrwf.theberridge.com/dev-listings

# Notifications API
HEROKU_NOTIFICATIONS_API=https://mrwf.theberridge.com/dev-notifications

# API key for Heroku APIs
HEROKU_API_KEY=

# Android SDK/API keys
ANDROID_GOOGLE_MAPS_SDK_API_KEY=
ANDROID_GOOGLE_MAPS_DIRECTIONS_API_KEY=
# Public SHA-1 certificate fingerprint used by Google Maps restrictions.

# Use the certificate for the installed build (debug, upload or Play signing).
SIGNING_KEY=

# iOS SDK/API keys, and Bundle ID
IOS_GOOGLE_MAPS_SDK_API_KEY=
IOS_GOOGLE_MAPS_DIRECTIONS_API_KEY=
IOS_BUNDLE_ID=org.millroadwinterfair.MRWFapp
